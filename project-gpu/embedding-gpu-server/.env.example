# Required (production)
EMBED_HOST=127.0.0.1
EMBEDDING_API_KEY=replace-with-strong-secret

# Optional auth override for local dev only (0/1)
EMBEDDING_DISABLE_AUTH=0

# Model settings
# - Local path (recommended): ./models or absolute path
# - If model dir is placed directly under embedding-gpu-server, set to ./
# - Multi-model folder structure examples:
#   ./models/qwen3-embedding-4b
#   ./models/Qwen/Qwen3-Embedding-4B
#   ./models/kure-v1
#   ./models/nlpai-lab/kure-v1
#   ./models/multilingual-e5-large
# - Auto-select priority (when path points to ./models):
#   qwen3-embedding-4b -> kure-v1 계열 -> multilingual-e5-large -> first valid model folder
# - If this fixed path does not exist, run scripts fall back to auto-detection.
EMBEDDING_MODEL_LARGE_PATH=./models/Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DEFAULT_INDEX=large
EMBEDDING_API_LARGE_ALIAS=large
# Task prefix mode for bi-encoder input:
# - auto: qwen3-embedding 모델은 instruct/query 형식, e5 계열은 query:/passage:, 그 외는 prefix 없음 (recommended)
# - qwen: force Qwen query instruction mode
# - e5: force "query:" / "passage:"
# - none: force no prefix
EMBEDDING_TASK_PREFIX_MODE=auto
EMBEDDING_QWEN_QUERY_INSTRUCTION="Given a user question, retrieve relevant passages that answer the question"
EMBEDDING_MODEL_DEVICE=cuda

# Encoding settings
EMBED_BATCH_SIZE=16
EMBED_NORMALIZE=1
